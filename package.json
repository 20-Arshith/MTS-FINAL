{
  "name": "mts-india",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Service Platform",
  "main": "backend/src/index.js",
  "workspaces": [
    "backend",
    "frontend/mts-project/admin-dashboard",
    "frontend/mts-project/vendor",
    "frontend/mts-project/agent/agent-app",
    "frontend/mts-project/USER/react_native_app"
  ],
  "scripts": {
    "start": "npm run start --workspace backend",
    "dev": "npm run dev --workspace backend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:admin": "npm run dev --workspace admin-dashboard",
    "start:vendor": "npm run start --workspace tempvendor",
    "start:agent": "npm run start --workspace agent-app",
